# Meeting Assistant - 環境変数設定例

# --- LLM / STT (クラウド) ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# 利用するクラウドSTTに応じて設定 (Google Cloud Speech-to-Text / Azure Speech / OpenAI Realtime API 等)
STT_PROVIDER=cloud
CLOUD_STT_API_KEY=your_cloud_stt_api_key_here

# --- サーバー設定 (FastAPI) ---
BACKEND_PORT=8000
ENV=development

# --- フロントエンド設定 ---
FRONTEND_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:8000/ws

# --- セキュリティ設定 ---
CORS_ORIGIN=http://localhost:3000

# --- データストア ---
DATABASE_URL=postgresql://user:password@localhost:5432/meeting_assistant

# --- 音声処理設定 ---
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# --- ログ設定 ---
LOG_LEVEL=info
