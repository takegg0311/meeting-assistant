# Meeting Assistant - 環境変数設定例

# ------------------------------------------------------------
# 基本環境設定
# ------------------------------------------------------------

# --- 起動ポート ---
ENV=development    # development / production
FRONTEND_PORT=3000    # Frontend (Vite開発サーバー)
BACKEND_PORT=8000    # Backend (FastAPI)

# --- LLM (回答提案・ファクトチェック・議事録生成用) ---
LLM_PROVIDER=mock   # mock / cloud_anthropic

# --- STT設定 ---
# セッション開始時にクライアントが指定する想定だが、サーバー側デフォルトとしても使用
STT_PROVIDER=mock    # mock / cloud_openai / cloud_google / local_whispercpp
STT_LANGUAGE=ja    # ja / en

# --- 回答提案 (Phase 2) ---
ANSWER_SUGGESTION_GRACE_MS=1500        # 「回答提案」ボタン押下後、確定セグメントの到着を待つ猶予時間(ms)。押下時点では質問末尾がSTT未確定な可能性が高いため待つ。無音なら早めに打ち切る。
ANSWER_SUGGESTION_QUESTION_SEGMENTS=2        # 質問候補として扱う直近セグメント数
ANSWER_SUGGESTION_CONTEXT_SEGMENTS=8        # その前に文脈として渡すセグメント数
ANSWER_SUGGESTION_MAX_CONCURRENCY=3        # 同時に走らせる生成タスクの上限(連打時の保護)
ANSWER_SUGGESTION_TIMEOUT_MS=15000        # 回答提案生成のタイムアウト時間(ms)。超えた分はキャンセルする
ANSWER_SUGGESTION_STOP_GRACE_MS=3000        # セッション終了時に生成中の回答提案を待つ上限(ms)。超えた分はキャンセルする

# --- セキュリティ設定 ---
# 別ホストからアクセスさせる場合のみ明示する(例: CORS_ORIGIN=http://localhost:3000)。
# 規定値では FRONTEND_PORT から http://localhost:<FRONTEND_PORT> と http://127.0.0.1:<FRONTEND_PORT> が許可される。
# CORS_ORIGIN=http://localhost:3000

# --- データストア ---
DATABASE_URL=postgresql://user:password@localhost:5432/meeting_assistant    # データベース接続URL

# --- 音声処理設定 ---
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# ------------------------------------------------------------
# プロバイダ別設定
# ------------------------------------------------------------

# --- OpenAI Realtime STT (STT_PROVIDER=cloud_openai) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_REALTIME_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime

# --- Google Cloud Speech-to-Text (STT_PROVIDER=cloud_google) ---
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json    # サービスアカウント鍵JSONのパス
GOOGLE_STT_LANGUAGE_CODE=ja-JP

# --- whisper.cpp Vulkanビルド (STT_PROVIDER=local_whispercpp) ---
WHISPER_CPP_BINARY=/path/to/whisper.cpp/build/bin/whisper-cli   # ホスト上でビルド済みの whisper-cli バイナリを指定(Docker・Pythonバインディングは使わない)
WHISPER_CPP_MODEL_DIR=./models/whisper_cpp  # GGMLモデル格納先(未設定時は ./models/whisper_cpp)
WHISPER_CPP_MODEL=base  # tiny / base / small / medium / large / largev2
WHISPER_CPP_BEAM_SIZE=5    # 5 / 10 / 20
WHISPER_CPP_FLASH_ATTN=false    # false / true (AMD Vulkanではfalse推奨)
WHISPER_CPP_GPU_DEVICE=0    # 0 / 1 / 2 / ...
WHISPER_CPP_THREADS=0    # 0 / 1 / 2 / ...

# --- VAD (whisper.cpp用の発話区切り検出) ---
VAD_SILENCE_THRESHOLD_MS=700
VAD_ENERGY_THRESHOLD=0.01

# --- Anthropic (LLM_PROVIDER=cloud_anthropic) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here       # LLM_PROVIDER=cloud_anthropic の場合必須
ANTHROPIC_ANSWER_MODEL=claude-haiku-4-5-20251001    # 回答提案は2〜3秒目標のため軽量モデルを既定にする
ANTHROPIC_ANSWER_MAX_TOKENS=1024

# ------------------------------------------------------------
# 開発者向け設定
# ------------------------------------------------------------

# --- ログレベル設定 ---
LOG_LEVEL=info
